{
  "title": "End-of-turn hooks across coding agents",
  "reference": "https://github.com/raimondasl/isitdone/blob/main/docs/agent-hooks.md",
  "checked": "2026-09-19",
  "fields": {
    "id": "Short stable identifier.",
    "agent": "Product name.",
    "kind": "command-hook: the agent runs a command with a JSON payload on stdin. plugin: the agent loads in-process code; there is no command protocol.",
    "projectConfig": "Hook file inside the repository. <name> is a file or directory name you choose.",
    "userConfig": "Hook file in the user's home (~).",
    "userConfigWindows": "The user file on Windows, where it differs.",
    "scopes": "Scopes the agent reads hooks from by default.",
    "configShape": "Where the hook entry sits inside the file.",
    "event": "End-of-turn event name, spelled as the agent spells it.",
    "canBlock": "veto: the turn cannot end until the hook allows it. follow-up: the turn ends and the hook's text is submitted as the next user message.",
    "blockVia": "stdout-json | exit-2 (reason on stderr) | followup-message | plugin-prompt.",
    "blockOutput": "Exact stdout JSON that blocks; <reason> is your text. null when there is no stdout protocol.",
    "allowOutput": "Stdout that lets the agent stop (exit code 0).",
    "finalMessage": "Does the hook get the agent's final message of the turn?",
    "finalMessageField": "Payload field that carries it, or null.",
    "continuationFlag": "Payload field that says this stop follows a hook's own block, or null.",
    "hostBlockCap": "Consecutive blocks the agent honours before it ends the turn anyway; null when none is documented.",
    "timeoutField / timeoutUnit / timeoutDefault": "Config key, unit (s or ms) and default of the hook timeout; null when not documented.",
    "timeoutLegacyMsFrom": "A timeout value at or above this number is read as milliseconds although the unit is seconds.",
    "failOpen": "A crashed, timed-out or malformed hook lets the agent stop.",
    "postEdit": "Event after a file edit whose output the agent (not only the user) sees: event, tool matcher, output channel. null when there is none.",
    "alsoLoads": "Other agents' hook files this agent reads by default.",
    "docs": "Vendor documentation.",
    "unverified": "Claims in this entry that the vendor page did not confirm on the checked date."
  },
  "agents": [
    {
      "id": "claude",
      "agent": "Claude Code",
      "kind": "command-hook",
      "projectConfig": ".claude/settings.json",
      "userConfig": "~/.claude/settings.json",
      "scopes": ["project", "user"],
      "configShape": "hooks.Stop[].hooks[]",
      "event": "Stop",
      "canBlock": "veto",
      "blockVia": ["stdout-json", "exit-2"],
      "blockOutput": { "decision": "block", "reason": "<reason>" },
      "allowOutput": "",
      "finalMessage": true,
      "finalMessageField": "last_assistant_message",
      "continuationFlag": "stop_hook_active",
      "hostBlockCap": 8,
      "timeoutField": "timeout",
      "timeoutUnit": "s",
      "timeoutDefault": 600,
      "failOpen": true,
      "postEdit": { "event": "PostToolUse", "matcher": "Edit|Write|MultiEdit", "channel": "hookSpecificOutput.additionalContext" },
      "alsoLoads": [],
      "docs": "https://code.claude.com/docs/en/hooks",
      "unverified": []
    },
