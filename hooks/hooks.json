{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @aivolution/isitdone@0.6.1 hook --host claude",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @aivolution/isitdone@0.6.1 hook --host claude --event edit",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
